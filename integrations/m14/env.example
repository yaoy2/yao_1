# Save real values outside Git, e.g. repository-root .env.m14 (ignored).
GITHUB_BACKUP_TOKEN=
GITHUB_BACKUP_REPO=yaoy2/yao_1
GITHUB_BACKUP_BRANCH=main

# HTTP only. GitHub OAuth App callback: https://YOUR-HOST/auth/callback
M14_PUBLIC_URL=
M14_GITHUB_CLIENT_ID=
M14_GITHUB_CLIENT_SECRET=
M14_GITHUB_USER_ID=
M14_JWT_SIGNING_KEY=
M14_STORAGE_KEY=
M14_AUTH_STATE_DIR=/var/lib/m14-auth

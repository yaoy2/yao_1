# 复制本文件为 .env 后填写。不要把 .env 提交到 Git。

# OpenList 只读账号，不要填管理员账号。
OPENLIST_BASE_URL=http://127.0.0.1:5244
OPENLIST_USERNAME=organizer-readonly
OPENLIST_PASSWORD=please-change-me

# OpenList 里 115 的挂载路径。建议就是 /云下载
OPENLIST_MOUNT_PATH=/云下载

# 程序层强制限制：所有扫描路径必须在这个根目录下。
ALLOWED_ROOT=/云下载

# 通用写入入口保持 false。远程整理只走带审核清单和确认码的专用执行器。
WRITE_MODE=false

# 默认只扫 50 个文件。扫描 500 / 5000 / 全部时用命令行覆盖。
DEFAULT_MAX_FILES=50
DEFAULT_SCAN_DEPTH=8
DEFAULT_SCAN_DIR=/云下载
